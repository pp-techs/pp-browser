{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PP Browser",
  "version": "0.1.0",
  "identifier": "com.ppbrowser.desktop",
  "build": {
    "frontendDist": "../frontend",
    "beforeDevCommand": "node scripts/prepare.mjs",
    "beforeBuildCommand": "node scripts/prepare.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PP Browser",
        "width": 1440,
        "height": 900,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/bun"],
    "resources": {
      "resources/ppb": "resources/ppb"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
